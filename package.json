{
  "name": "canopus",
  "version": "1.0.0",
  "description": "Canopus — personal dashboard, packaged as a desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.canopus.app",
    "productName": "Canopus",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "icon": "apple-touch-icon.png"
    }
  },
  "allowScripts": {
    "active-win@8.2.1": true,
    "electron@31.7.7": true
  }
}